        "start:desktop": "nodemon server.desktop.ts"
    },
    "dependencies": {
        "@prisma/client": "^6.19.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node-fetch": "^2.6.13",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "csurf": "^1.11.0",
        "dotenv": "^16.4.5",
        "express": "^4.18.2",
        "express-rate-limit": "^8.5.2",
        "helmet": "^8.2.0",
        "jsonwebtoken": "^9.0.3",
        "node-fetch": "^2.7.0",
        "razorpay": "^2.9.6",
        "socket.io": "^4.8.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.19",
        "nodemon": "^3.0.3",
        "prisma": "^6.19.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
